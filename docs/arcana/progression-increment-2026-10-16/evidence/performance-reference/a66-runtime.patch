+                      language={language}
+                      decorative
+                      eager
+                    />
+                  </span>
+                  <Artwork
+                    asset="ui.temporary"
+                    language={language}
+                    className="tactical-pact-origin"
+                    decorative
+                    eager
+                  />
+                  {chosen && (
+                    <Artwork
+                      asset="ui.seal"
+                      language={language}
+                      className="tactical-pact-seal"
