+                data-pact-candidate={candidate.id}
+                onClick={() =>
+                  onChange({
+                    pactAction: 'recruit',
+                    recruitId: candidate.id,
+                    ...(full && replacement ? { replaceUnitId: replacement.unit.id } : {}),
