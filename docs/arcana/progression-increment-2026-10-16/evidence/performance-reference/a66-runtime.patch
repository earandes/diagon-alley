+                    </dd>
+                  </div>
+                  <div>
+                    <dt>{c('mana')}</dt>
+                    <dd>
+                      {candidate.mana} / {candidate.maxMana}
+                    </dd>
+                  </div>
+                  <div>
+                    <dt>{c('power')}</dt>
+                    <dd>{candidate.power}</dd>
+                  </div>
+                  <div>
