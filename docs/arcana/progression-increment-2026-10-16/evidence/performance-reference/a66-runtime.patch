+          const candidateMembers =
+            !full || replacement
+              ? [
+                  ...run.members.filter(
+                    (member) => !full || member.unit.id !== replacement?.unit.id,
+                  ),
+                  { unit: candidate },
+                ]
+              : undefined;
+          const after =
+            candidateMembers &&
+            synergyProgress(candidateMembers.map(({ unit }) => unit)).find(
+              (synergy) => synergy.affinity === candidate.affinity,
+            );
