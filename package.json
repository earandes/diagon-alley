{
  "name": "coleccion-magica-i1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5189 --strictPort --mode arcana",
    "dev:arcana": "vite --host 127.0.0.1 --port 5189 --strictPort --mode arcana",
    "build": "npm run validate:skin && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.trial.config.ts",
    "verify:arcana:build": "node tools/arcana/verify-build.mjs",
    "validate:content": "vitest run tests/domain/arcana/trial-content.test.ts",
    "test:arcana": "vitest run tests/domain/arcana",
    "test:arcana:browser": "playwright test --config playwright.arcana.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "services:up": "docker compose -f compose.arcana.yml up -d --wait",
    "services:stop": "docker compose -f compose.arcana.yml stop",
    "preview:arcana": "vite preview --host 127.0.0.1 --port 5190 --strictPort --mode arcana",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "validate:skin": "node tools/arcana/validate-content-pack.mjs --complete",
    "test:opening": "playwright test --config playwright.opening.config.ts",
    "test:art": "playwright test --config playwright.art.config.ts",
    "test:experience": "playwright test --config playwright.experience.config.ts",
    "test:pokelike": "playwright test --config playwright.pokelike.config.ts",
    "test:commerce": "playwright test --config playwright.commerce-a60.config.ts",
    "test:browser:local": "node tools/verification/run-local-browser-smoke.mjs",
    "test:browser:check": "node tools/verification/run-local-browser-smoke.mjs --check"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "gsap": "3.15.0",
    "idb": "8.0.4",
    "motion": "14.2.0",
    "pg": "8.23.1",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
